{
    "_comment": "V2 — 1D European option, ultraweak DPG formulation (MPI parallel)",
    "option_type": "call",
    "sigma": 0.2,
    "r": 0.05,
    "T": 1.0,
    "K": 100.0,
    "S0": 100.0,
    "domain": {
        "x_min": -3.0,
        "x_max":  3.0,
        "_comment": "log-price coordinates: x = log(S/K)"
    },
    "mesh": {
        "N_x": 64,
        "uniform": true
    },
    "time": {
        "N_t": 100,
        "scheme": "backward_euler"
    },
    "fem": {
        "p": 2,
        "delta_p": 1,
        "_comment": "L2(p-1)=L2(1) trial; O(h^2) spatial convergence; delta via sigma=diff*grad(u)"
    },
    "solver": {
        "type": "pcg",
        "preconditioner": "boomeramg",
        "max_iter": 1000,
        "rtol": 1e-10,
        "atol": 1e-12
    },
    "mpi": {
        "num_procs": 4,
        "_comment": "used only for documentation; actual nprocs set by mpirun"
    },
    "output": {
        "csv_prefix": "results/convergence/v2_european_1d_ultraweak",
        "save_solution": true,
        "save_greeks": true,
        "refinement_levels": [0, 1, 2, 3, 4]
    }
}
